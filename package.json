{
  "name": "dot-triples-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test": "pnpm -r test",
    "pack:check": "node scripts/validate-packages.mjs",
    "publish:packages": "node scripts/publish-packages.mjs",
    "publish:packages:dry-run": "node scripts/publish-packages.mjs --dry-run",
    "trust:github": "node scripts/configure-trusted-publishing.mjs",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run"
  },
  "devDependencies": {
    "@release-it/bumper": "7.0.6",
    "release-it": "^20.2.1"
  },
  "release-it": {
    "plugins": {
      "@release-it/bumper": {
        "out": "packages/*/package.json"
      }
    },
    "hooks": {
      "before:init": [
        "pnpm test",
        "pnpm run pack:check"
      ],
      "after:bump": [
        "pnpm install --lockfile-only",
        "pnpm run pack:check"
      ]
    },
    "git": {
      "requireBranch": "main",
      "requireCleanWorkingDir": true,
      "commitMessage": "chore(release): v${version}",
      "tagName": "v${version}",
      "push": true
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    }
  }
}
