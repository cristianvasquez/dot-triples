{
  "name": "dot-triples-monorepo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test": "pnpm -r test",
    "test:spec": "node --test spec/typecheck.test.js",
    "publish:packages": "pnpm -r publish --access public",
    "publish:packages:dry-run": "pnpm -r publish --dry-run --force --no-git-checks --access public",
    "trust:github": "pnpm -r --workspace-concurrency=1 exec npm trust github --file npm-publish.yml --repo cristianvasquez/dot-triples --allow-publish --yes",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run"
  },
  "devDependencies": {
    "@release-it/bumper": "8.0.0",
    "release-it": "^21.0.2"
  },
  "release-it": {
    "plugins": {
      "@release-it/bumper": {
        "out": "packages/*/package.json"
      }
    },
    "hooks": {
      "before:init": [
        "pnpm test"
      ],
      "after:bump": [
        "pnpm install --lockfile-only",
        "pnpm run publish:packages:dry-run"
      ]
    },
    "git": {
      "requireBranch": "main",
      "requireCleanWorkingDir": true,
      "commitMessage": "chore(release): v${version}",
      "tagName": "v${version}",
      "push": true
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    }
  }
}
